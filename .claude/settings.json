{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(npx *)",
      "Bash(corepack *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git tag *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch*)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files*)",
      "Bash(mkdir *)",
      "PowerShell(pnpm *)",
      "PowerShell(node *)",
      "PowerShell(npx *)",
      "PowerShell(corepack *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git tag *)",
      "PowerShell(git checkout *)",
      "PowerShell(git switch *)",
      "PowerShell(git branch*)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git ls-files*)",
      "WebSearch",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:orm.drizzle.team)",
      "WebFetch(domain:hono.dev)",
      "WebFetch(domain:vite-pwa-org.netlify.app)",
      "WebFetch(domain:vite.dev)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:dexie.org)",
      "WebFetch(domain:tanstack.com)",
      "WebFetch(domain:zod.dev)",
      "WebFetch(domain:playwright.dev)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:web.dev)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:catmetal.com)"
    ],
    "deny": [
      "Bash(*git push*)",
      "Bash(gh *)",
      "Bash(*wrangler deploy*)",
      "Bash(*wrangler versions*)",
      "Bash(*wrangler secret*)",
      "Bash(*wrangler login*)",
      "Bash(*--remote*)",
      "Bash(*api.cloudflare.com*)",
      "PowerShell(*git push*)",
      "PowerShell(gh *)",
      "PowerShell(*wrangler deploy*)",
      "PowerShell(*wrangler versions*)",
      "PowerShell(*wrangler secret*)",
      "PowerShell(*wrangler login*)",
      "PowerShell(*--remote*)",
      "PowerShell(*api.cloudflare.com*)",
      "Edit(./.claude/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guardia.mjs"],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/no-parar.mjs"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
